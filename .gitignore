# Protect local clinical records and credentials when publishing portfolio code.
.env
.env.*
*.key
*.pem
.venv/
venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
*.pyc

# Canonical input names may be replaced with restricted patient data.
demo_data/EpicCosmos_cohort.csv
demo_data/NARCOMS_cohort.csv

# Keep only explicitly synthetic CSVs if publishing to public GitHub.
*.csv
!demo_data/SYNTHETIC_EpicCosmos_cohort.csv
!demo_data/SYNTHETIC_NARCOMS_cohort.csv

# Generated results can contain sensitive or disclosive summary cells.
outputs/
results/
raw_data/
private_data/
restricted_data/
real_data/
*.parquet
*.sqlite
*.db
.DS_Store
